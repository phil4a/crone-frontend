# Скопируйте в .env.local и подставьте реальные значения.

# --- Публичные (вшиваются в клиентский бандл на этапе next build) ---
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_API_URL=https://api.example.com/wp-json/wp/v2
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_ID=
NEXT_PUBLIC_LIGHT_GALLERY_LICENSE_KEY=
NEXT_PUBLIC_YM_ID=

# Deprecated: в src/ больше не читается, остался только в Dockerfile и CI-проверке.
NEXT_PUBLIC_GRAPHQL_API_URL=https://api.example.com/graphql

# --- Серверные: GraphQL endpoint WordPress ---
# Браузер ходит только в /api/graphql, прокси-роут подставляет один из этих адресов.
# Приоритет: build-time -> PUBLIC; runtime -> INTERNAL -> PUBLIC -> хардкод-фолбэк.
# INTERNAL задаётся в env приложения Dokploy (адрес внутри docker-сети), локально не нужен.
WORDPRESS_API_URL_INTERNAL=
WORDPRESS_API_URL_PUBLIC=https://api.example.com/graphql

# --- Серверные: формы и капча ---
CONTACT_FORM_7_ID=
CONTACT_FORM_7_UNIT_TAGS={}
YANDEX_SMARTCAPTCHA_SITE_KEY=ysc1_...
YANDEX_SMARTCAPTCHA_SERVER_KEY=ysc2_...
# Диагностический флаг: 1 перестаёт передавать IP клиента в /validate.
YANDEX_SMARTCAPTCHA_SKIP_IP=
